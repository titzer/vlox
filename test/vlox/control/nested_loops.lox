// Nested block/loop nests: the branch depths in `br`/`br_if` have to account for
// every enclosing structured block.
var total = 0;
for (var i = 0; i < 4; i = i + 1) {
  for (var j = 0; j < 4; j = j + 1) {
    var k = 0;
    while (k < 2) {
      total = total + 1;
      k = k + 1;
    }
  }
}
print total; // expect: 32

var s = "";
for (var i = 0; i < 3; i = i + 1) {
  if (i == 1) {
    for (var j = 0; j < 2; j = j + 1) s = s + "-";
  } else {
    s = s + "+";
  }
}
print s; // expect: +--+
