class Point {
  init(x, y) {
    this.x = x;
    this.y = y;
  }
  str() { return "(" + this.xs() + ", " + this.ys() + ")"; }
  xs() { if (this.x == 1) return "1"; return "?"; }
  ys() { if (this.y == 2) return "2"; return "?"; }
}
var p = Point(1, 2);
print p.str();          // expect: (1, 2)
print p.init(3, 4).x;   // expect: 3
print p == p.init(5, 6); // expect: true

class Bare {
  init() { return; }
}
print Bare();            // expect: Bare instance
