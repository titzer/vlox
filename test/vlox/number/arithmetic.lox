print 3 + 4 * 2 - 1;        // expect: 10
print (3 + 4) * (2 - 1);    // expect: 7
print 7 / 2;                // expect: 3.5
print -(-5);                // expect: 5
print - -  -5;              // expect: -5
print 1 / 0 > 0;            // expect: true
print -1 / 0 < 0;           // expect: true
var nan = 0 / 0;
print nan == nan;           // expect: false
print nan != nan;           // expect: true
print 0 == -0;              // expect: true
