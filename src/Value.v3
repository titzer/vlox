// A Lox value.
type Value #unboxed { // XXX: consider NaN-boxing
	case Undef;
	case Nil;
	case Bool(v: bool);
	case Num(v: double);
	case Ref(obj: LoxObject);
}


component Values {
	def TRUE = Value.Bool(true);
	def FALSE = Value.Bool(false);
	def NIL = Value.Nil;

	def box(b: bool) -> Value {
		return if(b, TRUE, FALSE);
	}
	// Lox truthiness: only {nil} and {false} are falsey.
	def truthy(v: Value) -> bool {
		match (v) {
			Nil => return false;
			Bool(b) => return b;
			_ => return true;
		}
	}
	// Render {v} the way Lox's {print} does.
	def render(buf: StringBuilder, v: Value) -> StringBuilder {
		match (v) {
			Undef => return buf.puts("<undefined>");
			Nil => return buf.puts("nil");
			Bool(b) => return buf.puts(if(b, "true", "false"));
			Num(d) => return Numbers.render(buf, d);
			Ref(o) => return o.render(buf);
		}
	}
	def isString(v: Value) -> bool {
		match (v) {
			Ref(o) => return LoxString.?(o);
			_ => return false;
		}
	}
}

// Base class of every heap-allocated Lox object.
class LoxObject {
	def render(buf: StringBuilder) -> StringBuilder;
}

// A Lox string. Allocate via {StringPool.intern}, not directly: Lox `==` on strings
// is the {Ref} case's reference comparison, and {LoxStrings} maps compare keys the
// same way, so a string built outside the pool would silently compare unequal.
class LoxString(str: string, hash: int) extends LoxObject {
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.puts(str);
	}
}

// Maps keyed by interned strings: hashing is a field read, equality a pointer compare.
component LoxStrings {
	def newMap<V>() -> HashMap<LoxString, V> {
		return HashMap<LoxString, V>.new(LoxString.hash, LoxString.==);
	}
}

// A boxed local variable. Locals that some inner function captures are stored in a
// cell, so that the closure and the enclosing frame share one mutable location.
class LoxCell(var value: Value) extends LoxObject {
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.puts("<cell>");	// never reachable from Lox code
	}
}

// A closure: a compiled function plus the cells it captured.
class LoxClosure(func: FuncDecl, cells: Array<LoxCell>) extends LoxObject {
	def render(buf: StringBuilder) -> StringBuilder {
		if (func.kind == FuncKind.SCRIPT) return buf.puts("<script>");
		return buf.put1("<fn %s>", func.name);
	}
}

// A builtin implemented in Virgil, e.g. {clock}.
class LoxNative(name: string, arity: int, invoke: Array<Value> -> Value) extends LoxObject {
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.puts("<native fn>");
	}
}

// A class is a value.
class LoxClass(name: LoxString) extends LoxObject {
	var superclass: LoxClass;

	def methods = LoxStrings.newMap<LoxClosure>();
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.puts(name.str);
	}
	// Methods are copied down from the superclass at {inherit} time, so lookup is a
	// single hash probe with no chain walk.
	def findMethod(name: LoxString) -> LoxClosure {
		return methods[name];
	}
}

// An instance. A missing field reads back as {Value.Undef}, the default value of the
// variant, which is how absence is detected without a second hash probe.
class LoxInstance extends LoxObject {
	def cls: LoxClass;
	def fields = LoxStrings.newMap<Value>();
	new(cls) { }
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.put1("%s instance", cls.name.str);
	}
}

// A method closure with its receiver already bound, produced by reading a method
// off an instance (or off {super}) without immediately calling it.
class LoxBoundMethod extends LoxObject {
	def receiver: Value;
	def method: LoxClosure;
	new(receiver, method) { }
	def render(buf: StringBuilder) -> StringBuilder {
		return buf.put1("<fn %s>", method.func.name);
	}
}

// Interning table for Lox strings.
class StringPool {
	private def map = Strings.newMap<LoxString>();

	def intern(str: string) -> LoxString {
		var s = map[str];
		if (s != null) return s;
		s = LoxString.new(str, Strings.hash(str));
		map[str] = s;
		return s;
	}
}
