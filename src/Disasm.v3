// Renders a compiled module as a Wasm-style text listing. Because the bytecode is
// real Wasm, this is a real (if minimal) Wasm disassembler; the only Vlox-specific
// part is annotating calls below {Wasm.NUM_INTRINSICS} with the intrinsic name.
class Disassembler(module: Module) {
	private var indent: int;

	def renderModule(buf: StringBuilder) -> StringBuilder {
		buf.puts(";; ---- globals ----").ln();
		for (i < module.globals.length) {
			buf.puts("  ");
			renderGlobalDecl(buf, i);
			buf.ln();
		}
		if (module.names.length > 0) {
			buf.puts(";; ---- names ----").ln();
			for (i < module.names.length) {
				buf.put2("  [%d] %s", i, module.names[i].str).ln();
			}
		}
		for (i < module.funcs.length) {
			buf.ln();
			renderFunc(buf, module.funcs[i]);
		}
		return buf;
	}
	private def renderGlobalDecl(buf: StringBuilder, i: int) {
		buf.put1("(global %d ", i);
		match (module.globals[i]) {
			Const(value) => {
				buf.puts("lox (");
				renderValue(buf, value);
				buf.puts("))");
			}
			Var(varName) => buf.put1("(mut lox) $%s)", varName);
		}
	}
	def renderFunc(buf: StringBuilder, f: FuncDecl) -> StringBuilder {
		// Slot 0 is the callee, so the Wasm arity is one more than the Lox arity.
		buf.put2("(func %d $%s", f.index, f.name);
		putValTypes(buf, " (param", f.arity() + 1);
		putValTypes(buf, " (local", f.numLocals - f.arity() - 1);
		buf.puts("  ;; ");
		f.span.render(buf);
		if (f.captures.length > 0) {
			buf.puts(" captures");
			for (i < f.captures.length) {
				match (f.captures[i]) {
					FromLocal(slot) => buf.put1(" local%d", slot);
					FromUpvalue(index) => buf.put1(" up%d", index);
				}
			}
		}
		buf.ln();
		indent = 1;
		var d = DataReader.new(f.code);
		while (d.more()) renderInstr(buf, f, d);
		return buf.puts(")").ln();
	}
	private def putValTypes(buf: StringBuilder, head: string, n: int) {
		if (n <= 0) return;
		buf.puts(head);
		for (i < n) buf.puts(" lox");
		buf.putc(')');
	}
	// Render the instruction at the reader's position, leaving it on the next one.
	private def renderInstr(buf: StringBuilder, f: FuncDecl, d: DataReader) {
		var pc = d.pos;
		var op = d.read1();
		if (op == Wasm.END || op == Wasm.ELSE) indent--;
		// {pad} works on the whole buffer, so column targets are relative to the
		// start of this line.
		var col = buf.length;
		var t = f.posAt(pc);
		buf.put2("%d:%d", t.0, t.1).pad(' ', col + 9);
		buf.putc('|').putd(pc).pad(' ', col + 15);
		for (i < indent) buf.puts("  ");
		match (op) {
			Wasm.UNREACHABLE => buf.puts("unreachable");
			Wasm.NOP => buf.puts("nop");
			Wasm.BLOCK => { putBlock(buf, "block", d.read1()); indent++; }
			Wasm.LOOP => { putBlock(buf, "loop", d.read1()); indent++; }
			Wasm.IF => { putBlock(buf, "if", d.read1()); indent++; }
			Wasm.ELSE => { buf.puts("else"); indent++; }
			Wasm.END => buf.puts("end");
			Wasm.BR => imm(buf, d, "br");
			Wasm.BR_IF => imm(buf, d, "br_if");
			Wasm.RETURN => buf.puts("return");
			Wasm.DROP => buf.puts("drop");
			Wasm.LOCAL_GET => imm(buf, d, "local.get");
			Wasm.LOCAL_SET => imm(buf, d, "local.set");
			Wasm.LOCAL_TEE => imm(buf, d, "local.tee");
			Wasm.I32_EQZ => buf.puts("i32.eqz");
			Wasm.GLOBAL_GET => annotateGlobal(buf, imm(buf, d, "global.get"));
			Wasm.GLOBAL_SET => annotateGlobal(buf, imm(buf, d, "global.set"));
			Wasm.I32_CONST => buf.put1("i32.const %d", d.read_sleb32());
			Wasm.CALL => {
				var idx = imm(buf, d, "call");
				if (idx < Wasm.NUM_INTRINSICS) {
					buf.put1("  ;; %s", Wasm.intrinsicName(idx));
				} else {
					buf.put1("  ;; $%s", module.funcAt(idx).name);
				}
			}
			_ => buf.put1("<unknown 0x%x>", op);
		}
		buf.ln();
	}
	private def putBlock(buf: StringBuilder, name: string, bt: byte) {
		buf.puts(name);
		var t = blockType(bt);
		if (t.length > 0) buf.sp().puts(t);
	}
	// Render "<name> <index>" and return the index.
	private def imm(buf: StringBuilder, d: DataReader, name: string) -> int {
		var v = Wasm.readIndex(d);
		buf.put2("%s %d", name, v);
		return v;
	}
	private def annotateGlobal(buf: StringBuilder, idx: int) {
		buf.puts("  ;; ");
		match (module.globals[idx]) {
			Const(value) => renderValue(buf, value);
			Var(varName) => buf.put1("$%s", varName);
		}
	}
	private def renderValue(buf: StringBuilder, v: Value) {
		if (Values.isString(v)) {
			buf.putc('\"');
			Values.render(buf, v);
			buf.putc('\"');
		} else {
			Values.render(buf, v);
		}
	}
	private def blockType(b: byte) -> string {
		if (b == Wasm.BT_VOID) return "";
		if (b == Wasm.VT_LOX) return "(result lox)";
		if (b == Wasm.VT_I32) return "(result i32)";
		return "?";
	}
}
