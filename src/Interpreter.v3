// The Vlox virtual machine: a Wasm interpreter with a Lox runtime bolted on as
// intrinsics.
//
// Two value stacks, because the bytecode is genuinely two-typed. The {lox} stack
// holds Lox values and, per Wasm, also holds every function's locals in the frame
// slots below its operand area. The {i32} stack holds branch conditions and the
// immediate operands of the high-level opcodes. Nothing is ever live on the i32
// stack across a branch, so control transfers only have to truncate it.

// Where a `br` goes and what it must leave behind.
class Label {
	var target: int;	// pc to resume at
	var vheight: int;	// lox stack height on entry
	var iheight: int;	// i32 stack height on entry
	var arity: int;		// values the block leaves behind
	var isLoop: bool;	// branching to a loop re-enters it
}

class Frame {
	var func: FuncDecl;
	var closure: LoxClosure;
	var code: Array<byte>;	// cached from {func}, read on every instruction
	var side: SideTable;	// cached likewise
	var base: int;		// index of local 0 in the lox stack
	var pc: int;		// resume point
	var tracePc: int;	// instruction to blame in a stack trace
	var labelBase: int;
	var iBase: int;		// i32 stack height on entry
}

// Per-function control-flow map, computed once by scanning the code. A real Wasm
// engine builds the same thing during validation.
class SideTable(endPc: Array<int>, elsePc: Array<int>) { }

def SIGN_BIT: u64 = 0x8000_0000_0000_0000;
def FRAMES_MAX = 1024;
def STACK_MAX = 1 << 16;
def ISTACK_MAX = 1 << 10;

class Interpreter(module: Module) {
	private def stack = Array<Value>.new(STACK_MAX);
	private def istack = Array<int>.new(ISTACK_MAX);
	// Grown on demand: a frame's label depth is bounded by its static nesting, but
	// the total is that times the recursion depth, which has no small bound.
	private var labels = Array<Label>.new(256);
	private def frames = Array<Frame>.new(FRAMES_MAX);
	private def globals = Array<Value>.new(module.globals.length);
	private def sideTables = Array<SideTable>.new(module.funcs.length);
	private var vsp: int;
	private var isp: int;
	private var labelTop = -1;
	private var frameTop = -1;
	private var frame: Frame;
	private var errorMsg: string;
	private def reader = DataReader.new(Array<byte>.new(0));
	private def startUs = System.ticksUs();

	private def INIT = module.pool.intern("init");

	// Run the top-level script. Returns the process exit code: 0, or 70 for a Lox
	// runtime error (the value the reference implementation uses).
	def run() -> int {
		for (i < labels.length) labels[i] = Label.new();
		for (i < frames.length) frames[i] = Frame.new();
		initGlobals();
		for (i < sideTables.length) sideTables[i] = buildSideTable(module.funcs[i].code);
		var script = LoxClosure.new(module.funcs[0], []);
		stack[0] = Value.Ref(script);
		vsp = 1;
		if (pushFrame(script, 0, 0)) execute();
		else reportError();
		Io.flush();
		return if(errorMsg != null, 70, 0);
	}
	private def initGlobals() {
		for (i < module.globals.length) {
			match (module.globals[i]) {
				Const(value) => globals[i] = value;
				Var => globals[i] = Value.Undef;
			}
		}
		globals[module.globalFor(Natives.CLOCK)] = Value.Ref(LoxNative.new(Natives.CLOCK, 0, clockNative));
	}
	// The one builtin Lox defines: seconds elapsed since the program started.
	// Measured against {startUs} rather than reported raw, because the host's tick
	// counter is a wrapping 32-bit value with an arbitrary epoch.
	private def clockNative(args: Array<Value>) -> Value {
		var elapsed: double = System.ticksUs() - startUs;
		return Value.Num(elapsed / 1000000.0);
	}

	// ---- the dispatch loop ---------------------------------------------------------

	// The outer loop points the reader at the current frame's code; the inner loop
	// runs straight-line bytecode without touching the frame at all, and exits only
	// when a call or a return switches frames. The reader's {pos} is the pc.
	private def execute() {
		var d = reader;
		while (frameTop >= 0) {
			var f = frame, side = f.side;
			d.reset(f.code, f.pc, f.code.length);
			while (true) {
				var opPc = d.pos;
				var op = d.read1();
				match (op) {
					Wasm.NOP => ;
					Wasm.UNREACHABLE => {
						f.tracePc = opPc;
						failWith("Unreachable.");
						return;
					}
					Wasm.BLOCK => {
						var bt = d.read1();
						pushLabel(side.endPc[opPc], bt, false);
					}
					Wasm.LOOP => {
						var bt = d.read1();
						pushLabel(d.pos, bt, true);
					}
					Wasm.IF => {
						var bt = d.read1();
						if (ipop() != 0) {
							pushLabel(side.endPc[opPc], bt, false);
						} else if (side.elsePc[opPc] >= 0) {
							pushLabel(side.endPc[opPc], bt, false);
							d.at(side.elsePc[opPc]);
						} else {
							d.at(side.endPc[opPc]);
						}
					}
					Wasm.ELSE => {
						// Falling out of the taken arm: skip the other one.
						d.at(labels[labelTop].target);
						labelTop--;
					}
					Wasm.END => {
						if (labelTop < f.labelBase) {
							// End of the function body; its result is on top.
							f.tracePc = opPc;
							doReturn(stack[vsp - 1]);
							break;
						}
						labelTop--;
					}
					Wasm.BR => d.at(branch(Wasm.readIndex(d)));
					Wasm.BR_IF => {
						var depth = Wasm.readIndex(d);
						if (ipop() != 0) d.at(branch(depth));
					}
					Wasm.RETURN => {
						f.tracePc = opPc;
						doReturn(stack[vsp - 1]);
						break;
					}
					Wasm.DROP => vsp--;
					Wasm.LOCAL_GET => push(stack[f.base + Wasm.readIndex(d)]);
					Wasm.LOCAL_SET => stack[f.base + Wasm.readIndex(d)] = stack[--vsp];
					Wasm.LOCAL_TEE => stack[f.base + Wasm.readIndex(d)] = stack[vsp - 1];
					Wasm.GLOBAL_GET => push(globals[Wasm.readIndex(d)]);
					Wasm.GLOBAL_SET => globals[Wasm.readIndex(d)] = stack[--vsp];
					Wasm.I32_CONST => ipush(d.read_sleb32());
					Wasm.I32_EQZ => istack[isp - 1] = if(istack[isp - 1] == 0, 1, 0);
					Wasm.CALL => {
						var idx = Wasm.readIndex(d);
						// Only intrinsics are reached by a direct call; Lox
						// calls are dynamic and go through `lox.call`.
						if (idx >= Wasm.NUM_INTRINSICS) {
							f.tracePc = opPc;
							failWith("Direct call to a Lox function.");
							return;
						}
						f.pc = d.pos;	// resume point in *this* frame
						f.tracePc = opPc;
						if (!intrinsic(idx)) { reportError(); return; }
						if (frame != f) break;	// the intrinsic pushed a frame
					}
					_ => {
						f.tracePc = opPc;
						failWith("Illegal opcode.");
						return;
					}
				}
			}
		}
	}
	private def pushLabel(target: int, blockType: byte, isLoop: bool) {
		if (++labelTop >= labels.length) growLabels();
		var l = labels[labelTop];
		l.target = target;
		l.vheight = vsp;
		l.iheight = isp;
		l.arity = if(blockType == Wasm.BT_VOID || isLoop, 0, 1);
		l.isLoop = isLoop;
	}
	private def growLabels() {
		var bigger = Array<Label>.new(labels.length * 2);
		for (i < labels.length) bigger[i] = labels[i];
		for (i = labels.length; i < bigger.length; i++) bigger[i] = Label.new();
		labels = bigger;
	}
	// Unwind to the {depth}-th enclosing label and return the pc to resume at.
	private def branch(depth: int) -> int {
		var idx = labelTop - depth;
		var l = labels[idx];
		if (l.arity == 1) stack[l.vheight] = stack[vsp - 1];
		vsp = l.vheight + l.arity;
		isp = l.iheight;
		labelTop = if(l.isLoop, idx, idx - 1);
		return l.target;
	}
	private def doReturn(result: Value) {
		vsp = frame.base;
		isp = frame.iBase;
		labelTop = frame.labelBase - 1;
		frameTop--;
		if (frameTop < 0) { frame = null; return; }
		frame = frames[frameTop];
		push(result);
	}

	// ---- calling ---------------------------------------------------------------------

	// Push a frame for {closure}. {base} is the index of the callee value on the lox
	// stack, which becomes local 0; {argc} arguments follow it.
	private def pushFrame(closure: LoxClosure, base: int, argc: int) -> bool {
		if (frameTop + 1 >= FRAMES_MAX) return err("Stack overflow.");
		var f = closure.func;
		if (base + f.numLocals >= STACK_MAX) return err("Stack overflow.");
		frame = frames[++frameTop];
		frame.func = f;
		frame.closure = closure;
		frame.code = f.code;
		frame.side = sideTables[f.index - Wasm.NUM_INTRINSICS];
		frame.base = base;
		frame.pc = 0;
		frame.tracePc = 0;
		frame.labelBase = labelTop + 1;
		frame.iBase = isp;
		for (i = argc + 1; i < f.numLocals; i++) stack[base + i] = Values.NIL;
		vsp = base + f.numLocals;
		return true;
	}
	// The `lox.call` intrinsic: {argc} arguments sit above the callee.
	private def callValue(argc: int) -> bool {
		var base = vsp - argc - 1;
		var callee = stack[base];
		match (callee) {
			Ref(o) => {
				if (LoxClosure.?(o)) return callClosure(LoxClosure.!(o), base, argc);
				if (LoxClass.?(o)) return construct(LoxClass.!(o), base, argc);
				if (LoxBoundMethod.?(o)) {
					var b = LoxBoundMethod.!(o);
					stack[base] = b.receiver;
					return callClosure(b.method, base, argc);
				}
				if (LoxNative.?(o)) {
					var n = LoxNative.!(o);
					if (argc != n.arity) return arityError(n.arity, argc);
					var args = Array<Value>.new(argc);
					for (i < argc) args[i] = stack[base + 1 + i];
					var r = n.invoke(args);
					vsp = base;
					push(r);
					return true;
				}
			}
			_ => ;
		}
		return err("Can only call functions and classes.");
	}
	private def callClosure(c: LoxClosure, base: int, argc: int) -> bool {
		if (argc != c.func.arity()) return arityError(c.func.arity(), argc);
		return pushFrame(c, base, argc);
	}
	private def construct(cls: LoxClass, base: int, argc: int) -> bool {
		var inst = LoxInstance.new(cls);
		stack[base] = Value.Ref(inst);	// becomes the receiver in slot 0
		var init = cls.findMethod(INIT);
		if (init != null) return callClosure(init, base, argc);
		if (argc != 0) return arityError(0, argc);
		vsp = base;
		push(Value.Ref(inst));
		return true;
	}
	private def arityError(want: int, got: int) -> bool {
		return err(StringBuilder.new().put2("Expected %d arguments but got %d.", want, got).toString());
	}
	// The fused `o.m(args)` form: look up a field first (a callable field shadows a
	// method), then a method on the class.
	private def invoke(nameIdx: int, argc: int) -> bool {
		var base = vsp - argc - 1;
		var receiver = stack[base];
		var name = module.names[nameIdx];
		var inst = asInstance(receiver);
		if (inst == null) return err("Only instances have methods.");
		var field = inst.fields[name];
		if (!Value.Undef.?(field)) {
			stack[base] = field;
			return callValue(argc);
		}
		var m = inst.cls.findMethod(name);
		if (m == null) return undefinedProperty(name);
		return callClosure(m, base, argc);
	}
	private def invokeSuper(nameIdx: int, argc: int, superclass: LoxClass) -> bool {
		var base = vsp - argc - 1;
		var name = module.names[nameIdx];
		var m = superclass.findMethod(name);
		if (m == null) return undefinedProperty(name);
		return callClosure(m, base, argc);
	}

	// ---- intrinsics ------------------------------------------------------------------

	// Dispatch a `call` whose target is below NUM_INTRINSICS. The interpreter runs
	// these inline; a real backend would import or generate them as Wasm functions.
	private def intrinsic(idx: int) -> bool {
		match (idx) {
			Wasm.TRUTHY => { ipush(if(Values.truthy(pop()), 1, 0)); return true; }
			Wasm.NOT => { push(Values.box(!Values.truthy(pop()))); return true; }
			Wasm.NEG => {
				var v = pop();
				match (v) {
					// Flip the sign bit, as f64.neg does; `0.0 - d` would
					// turn -0.0 into +0.0.
					Num(d) => { push(Value.Num(double.view(u64.view(d) ^ SIGN_BIT))); return true; }
					_ => return err("Operand must be a number.");
				}
			}
			Wasm.ADD => return add();
			Wasm.SUB => return arith(idx);
			Wasm.MUL => return arith(idx);
			Wasm.DIV => return arith(idx);
			Wasm.EQ => { var b = pop(), a = pop(); push(Values.box(a == b)); return true; }
			Wasm.NE => { var b = pop(), a = pop(); push(Values.box(a != b)); return true; }
			Wasm.LT => return compare(idx);
			Wasm.LE => return compare(idx);
			Wasm.GT => return compare(idx);
			Wasm.GE => return compare(idx);
			Wasm.PRINT => { var v = pop(); Io.print(Values.render(_, v)); return true; }
			Wasm.CALL_VALUE => return callValue(ipop());
			Wasm.CHECK_GLOBAL => {
				var g = ipop();
				if (Value.Undef.?(stack[vsp - 1])) return undefinedVariable(g);
				return true;
			}
			Wasm.SET_GLOBAL => {
				var g = ipop();
				if (Value.Undef.?(globals[g])) return undefinedVariable(g);
				globals[g] = stack[vsp - 1];
				return true;
			}
			Wasm.CELL_NEW => { push(Value.Ref(LoxCell.new(pop()))); return true; }
			Wasm.CELL_GET => { push(LoxCell.!(asObject(pop())).value); return true; }
			Wasm.CELL_SET => {
				var v = pop(), c = LoxCell.!(asObject(pop()));
				c.value = v;
				push(v);
				return true;
			}
			Wasm.UPVALUE => { push(Value.Ref(frame.closure.cells[ipop()])); return true; }
			Wasm.CLOSURE => {
				var n = ipop(), funcidx = ipop();
				var cells = Array<LoxCell>.new(n);
				for (i < n) cells[i] = LoxCell.!(asObject(stack[vsp - n + i]));
				vsp -= n;
				push(Value.Ref(LoxClosure.new(module.funcAt(funcidx), cells)));
				return true;
			}
			Wasm.GET_FIELD => return getField(ipop());
			Wasm.SET_FIELD => return setField(ipop());
			Wasm.INVOKE => {
				var argc = ipop(), nameIdx = ipop();
				return invoke(nameIdx, argc);
			}
			Wasm.CLASS => {
				push(Value.Ref(LoxClass.new(module.names[ipop()])));
				return true;
			}
			Wasm.INHERIT => return inherit();
			Wasm.METHOD => return defineMethod(ipop());
			Wasm.GET_SUPER => return getSuper(ipop());
			Wasm.INVOKE_SUPER => {
				var argc = ipop(), nameIdx = ipop();
				var sup = pop();
				return invokeSuper(nameIdx, argc, LoxClass.!(asObject(sup)));
			}
			_ => return err("Unknown intrinsic.");
		}
	}
	private def add() -> bool {
		var b = pop(), a = pop();
		match (a) {
			Num(x) => match (b) {
				Num(y) => { push(Value.Num(x + y)); return true; }
				_ => ;
			}
			Ref(x) => match (b) {
				Ref(y) => {
					if (LoxString.?(x) && LoxString.?(y)) {
						var s = StringBuilder.new()
							.puts(LoxString.!(x).str)
							.puts(LoxString.!(y).str);
						push(Value.Ref(module.pool.intern(s.toString())));
						return true;
					}
				}
				_ => ;
			}
			_ => ;
		}
		return err("Operands must be two numbers or two strings.");
	}
	private def arith(op: int) -> bool {
		var b = pop(), a = pop();
		match (a) {
			Num(x) => match (b) {
				Num(y) => {
					var r = 0.0;
					if (op == Wasm.SUB) r = x - y;
					else if (op == Wasm.MUL) r = x * y;
					else r = x / y;
					push(Value.Num(r));
					return true;
				}
				_ => ;
			}
			_ => ;
		}
		return err("Operands must be numbers.");
	}
	private def compare(op: int) -> bool {
		var b = pop(), a = pop();
		match (a) {
			Num(x) => match (b) {
				Num(y) => {
					var r = false;
					if (op == Wasm.LT) r = x < y;
					else if (op == Wasm.LE) r = x <= y;
					else if (op == Wasm.GT) r = x > y;
					else r = x >= y;
					push(Values.box(r));
					return true;
				}
				_ => ;
			}
			_ => ;
		}
		return err("Operands must be numbers.");
	}
	private def getField(nameIdx: int) -> bool {
		var obj = pop();
		var name = module.names[nameIdx];
		var inst = asInstance(obj);
		if (inst == null) return err("Only instances have properties.");
		var v = inst.fields[name];
		if (!Value.Undef.?(v)) { push(v); return true; }
		var m = inst.cls.findMethod(name);
		if (m == null) return undefinedProperty(name);
		push(Value.Ref(LoxBoundMethod.new(obj, m)));
		return true;
	}
	private def setField(nameIdx: int) -> bool {
		var v = pop(), obj = pop();
		var inst = asInstance(obj);
		if (inst == null) return err("Only instances have fields.");
		inst.fields[module.names[nameIdx]] = v;
		push(v);
		return true;
	}
	private def inherit() -> bool {
		var sup = pop(), sub = pop();
		var supObj = asObject(sup);
		if (!LoxClass.?(supObj)) return err("Superclass must be a class.");
		var s = LoxClass.!(supObj), c = LoxClass.!(asObject(sub));
		c.superclass = s;
		// Copy methods down so that lookup never walks the chain. An override later
		// in the class body simply overwrites the inherited entry.
		s.methods.apply(copyMethod(c, _, _));
		push(sub);
		return true;
	}
	private def copyMethod(c: LoxClass, name: LoxString, m: LoxClosure) {
		c.methods[name] = m;
	}
	private def defineMethod(nameIdx: int) -> bool {
		var m = pop(), cls = pop();
		var c = LoxClass.!(asObject(cls));
		var closure = LoxClosure.!(asObject(m));
		c.methods[module.names[nameIdx]] = closure;
		push(cls);
		return true;
	}
	private def getSuper(nameIdx: int) -> bool {
		var sup = pop(), receiver = pop();
		var name = module.names[nameIdx];
		var m = LoxClass.!(asObject(sup)).findMethod(name);
		if (m == null) return undefinedProperty(name);
		push(Value.Ref(LoxBoundMethod.new(receiver, m)));
		return true;
	}

	// ---- stacks ------------------------------------------------------------------

	private def push(v: Value) {
		stack[vsp++] = v;
	}
	private def pop() -> Value {
		return stack[--vsp];
	}
	private def ipush(v: int) {
		istack[isp++] = v;
	}
	private def ipop() -> int {
		return istack[--isp];
	}
	private def asObject(v: Value) -> LoxObject {
		match (v) {
			Ref(o) => return o;
			_ => return null;
		}
	}
	private def asInstance(v: Value) -> LoxInstance {
		var o = asObject(v);
		return if(LoxInstance.?(o), LoxInstance.!(o));
	}

	// ---- preparation -------------------------------------------------------------

	// Match every structured-control opcode with its `else` and its `end`, the way a
	// Wasm engine does during validation.
	//
	// The arrays get one slot past the end of the code, and the scan starts with the
	// function body itself already open at that index. The body is a control scope
	// like any other -- it is what the final `end` closes -- so treating it as one
	// means {open} is never empty and neither `else` nor `end` needs a guard.
	private def buildSideTable(code: Array<byte>) -> SideTable {
		var n = code.length + 1;
		var endPc = Array<int>.new(n), elsePc = Array<int>.new(n);
		for (i < n) { endPc[i] = -1; elsePc[i] = -1; }
		var open = Vector<int>.new().put(code.length);
		var d = DataReader.new(code);
		while (d.more()) {
			var start = d.pos;
			match (d.read1()) {
				Wasm.BLOCK, Wasm.LOOP, Wasm.IF => {
					d.read1();		// block type
					open.put(start);
				}
				Wasm.ELSE => elsePc[open[open.length - 1]] = d.pos;
				Wasm.END => {
					endPc[open[open.length - 1]] = d.pos;
					open.resize(open.length - 1);
				}
				Wasm.BR, Wasm.BR_IF, Wasm.CALL, Wasm.LOCAL_GET, Wasm.LOCAL_SET,
				Wasm.LOCAL_TEE, Wasm.GLOBAL_GET, Wasm.GLOBAL_SET => d.read_uleb32();
				Wasm.I32_CONST => d.read_sleb32();
				_ => ;
			}
		}
		return SideTable.new(endPc, elsePc);
	}

	// ---- errors --------------------------------------------------------------------

	private def undefinedVariable(g: int) -> bool {
		match (module.globals[g]) {
			Var(varName) => return err(StringBuilder.new().put1("Undefined variable \'%s\'.", varName).toString());
			_ => return err("Undefined variable.");
		}
	}
	private def undefinedProperty(name: LoxString) -> bool {
		return err(StringBuilder.new().put1("Undefined property \'%s\'.", name.str).toString());
	}
	private def err(msg: string) -> bool {
		errorMsg = msg;
		return false;
	}
	private def failWith(msg: string) {
		errorMsg = msg;
		reportError();
	}
	// Report the pending error and its stack trace, in clox's exact format:
	//   Undefined variable 'x'.
	//   [line 3] in foo()
	//   [line 9] in script
	private def reportError() {
		Io.flush();
		Io.err(StringBuilder.puts(_, errorMsg));
		for (i = frameTop; i >= 0; i--) {
			var f = frames[i];
			var pc = if(i == frameTop, f.tracePc, f.pc - 1);
			var line = f.func.lineAt(pc);
			if (f.func.kind == FuncKind.SCRIPT) {
				Io.err(StringBuilder.put1(_, "[line %d] in script", line));
			} else {
				Io.err(StringBuilder.put2(_, "[line %d] in %s()", line, f.func.name));
			}
		}
		frameTop = -1;
		frame = null;
	}
}
